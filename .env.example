# Copiar este archivo como .env y completar credenciales

ORACLE_USER=tu_usuario
ORACLE_PASSWORD=tu_password
ORACLE_HOST=localhost
ORACLE_PORT=1521
ORACLE_SERVICE=FREEPDB1

# Opcional: cadena completa (si se define, tiene prioridad sobre HOST/PORT/SERVICE)
# ORACLE_DSN=host:1521/FREEPDB1

# Opcional: Instant Client (solo si necesitas Thick mode)
# ORACLE_CLIENT_LIB_DIR=C:\oracle\instantclient_23_5

APP_NAME=Grupo 3 - Análisis de Compras
APP_ENV=development
# Local + producción: agrega la URL del frontend desplegado
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5500,http://localhost:5500

